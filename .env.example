# Public host port mapped to the container port 4096
OPENCODE_PORT=4096

# HTTP basic auth for the web UI and the HTTP API
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-please

# Pin a release tag for reproducible builds, or keep "latest"
OPENCODE_VERSION=latest

# Optional: provider credentials, as an alternative to `make auth`
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
