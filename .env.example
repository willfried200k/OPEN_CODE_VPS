# Public host port mapped to the container port 4096
OPENCODE_PORT=4096

# HTTP basic auth for the web UI and the HTTP API
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-please

# Pin a release tag for reproducible builds, or keep "latest"
OPENCODE_VERSION=latest

# GitHub access: fine-grained PAT with "Contents: Read and write"
# GH_TOKEN=github_pat_...
# GIT_AUTHOR_NAME=willfried200k
# GIT_AUTHOR_EMAIL=willfried200k@users.noreply.github.com
# GIT_COMMITTER_NAME=willfried200k
# GIT_COMMITTER_EMAIL=willfried200k@users.noreply.github.com

# Optional: provider credentials, as an alternative to `make auth`
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
